<?xml version="1.0"?>
<robot name="conveyor">
  <link name="world"/>
  
  <link name="conveyor_base">
    <visual>
      <geometry>
        <box size="2.0 0.5 0.1"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="2.0 0.5 0.1"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="10.0"/>
      <inertia ixx="1.0" iyy="1.0" izz="1.0" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="conveyor_joint" type="fixed">
    <parent link="world"/>
    <child link="conveyor_base"/>
    <origin xyz="1.5 0.0 0.05"/>
  </joint>

  <link name="belt">
    <visual>
      <geometry>
        <box size="1.8 0.4 0.02"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="1.8 0.4 0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.1" iyy="0.1" izz="0.1" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="belt_joint" type="prismatic">
    <parent link="conveyor_base"/>
    <child link="belt"/>
    <origin xyz="0.0 0.0 0.06"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.9" upper="0.9" effort="100" velocity="1.0"/>
  </joint>
</robot>
